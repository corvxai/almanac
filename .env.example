# Optional: validators / CLI use this as the gateway-as-a-service base URL.
# GATEWAY_SERVICE_URL=https://gateway.arcratio.ai

# ---------------------------------------------------------------------------
# Bittensor wallet (validator container only — sandbox never reads these)
# ---------------------------------------------------------------------------
# Mount your wallet directory into the validator container at /root/.bittensor.
# These point at a wallet inside that mount.
# BITTENSOR_WALLET_PATH=/root/.bittensor/wallets
# BITTENSOR_WALLET_NAME=default
# BITTENSOR_WALLET_HOTKEY=default
# BITTENSOR_NETUID=0          # placeholder — set to the real arcratio netuid
# BITTENSOR_NETWORK=finney    # finney | test | local
# BITTENSOR_SIGNING_REQUIRED=true   # set to false (or use --unsafe-no-signing)
                                    # if running without a wallet for local dev

# ---------------------------------------------------------------------------
# Sandbox overrides (optional)
# ---------------------------------------------------------------------------
# SANDBOX_TYPE=docker_runc       # in_process | docker_runc | docker_gvisor
# SANDBOX_IMAGE=arcratio/agent-runner:latest
# SANDBOX_SOCKET_DIR=...   # default: <repo>/var/run/arcratio (host-friendly).
#                          # Compose sets /var/run/arcratio inside the validator.
# SANDBOX_BIND_SRC=   # optional: absolute *host* path to the same dir as the
#                     # compose bind for proxy.sock; auto-derived from
#                     # /proc/self/mountinfo when unset (validator-in-Docker).
# ARCRATIO_SANDBOX_RUNNER_LOGS_QUIET=1   # optional: suppress agent-runner log tails in validator stdout after each run

ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter (live gateway + ``pytest --live`` for ``test_provider_live_openrouter``)
OPENROUTER_API_KEY=sk-or-v1-...
# Optional: OpenRouter app attribution (https://openrouter.ai/docs/api/reference/authentication)
# OPENROUTER_HTTP_REFERER=https://yoursite.example
# OPENROUTER_APP_TITLE=arcratio-gateway

# Optional: token-pricing config used when providers omit per-call cost.
# Default file is config/pricing_cards.json; override path if needed:
# ARCRATIO_MODEL_PRICING_FILE=/absolute/path/to/pricing_cards.json
#
# Optional inline JSON override (merged on top of file cards), keyed by "<provider>/<model>":
# ARCRATIO_MODEL_PRICING_JSON={"claude/claude-sonnet-4-6":{"input_per_mtoken":3.0,"output_per_mtoken":15.0,"cache_read_input_per_mtoken":0.3,"cache_creation_input_per_mtoken":3.75}}