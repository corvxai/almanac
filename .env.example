# Almanac — public env template (repo-root `.env`)
#
# Miners usually only need GATEWAY_API_KEY. Orchestrator/gateway URLs default
# to production in `src/core/constants.py` — override only if you know you need to.
# See miner/README.md.

# Create a key at https://portal.almnc.ai
GATEWAY_API_KEY=

# Validators: required for W&B logging (or use --wandb.off)
WANDB_API_KEY=

# Optional (defaults are fine for most miners):
# FORECASTING_GATEWAY_API_KEY=
# FORECASTING_WALLET_PATH=~/.bittensor/wallets
# FORECASTING_WALLET_NAME=default
# FORECASTING_WALLET_HOTKEY=default
# FORECASTING_ORCHESTRATOR_URL=
# GATEWAY_SERVICE_URL=
# ORCHESTRATOR_API_URL=
# GATEWAY_DEBUG_RAW_RESPONSE=
